<view class="wrap">
  <view class="top">
    <view class="title">向日葵</view>
    <view class="meta">{{stats}}</view>
  </view>

  <view class="stage-wrap">
    <canvas
      type="webgl"
      id="sunflower"
      class="stage"
      disable-scroll="true"
      bindtouchstart="onTouchStart"
      catchtouchmove="onTouchMove"
      bindtouchend="onTouchEnd"
      bindtouchcancel="onTouchEnd"
    ></canvas>
  </view>

  <view class="bottom">
    <view class="tabs">
      <view
        wx:for="{{views}}"
        wx:key="key"
        class="tab {{current === item.key ? 'on' : ''}}"
        data-key="{{item.key}}"
        bindtap="onView"
        hover-class="tab-hover"
      >{{item.label}}</view>
    </view>
    <view class="row">
      <view
        class="chip {{auto ? 'on' : ''}}"
        bindtap="onToggleRotate"
        hover-class="chip-hover"
      >自动旋转 {{auto ? '开' : '关'}}</view>
      <view class="chip" bindtap="onReseed" hover-class="chip-hover">换一株</view>
      <view class="hint">单指旋转 · 双指缩放</view>
    </view>
  </view>
</view>
